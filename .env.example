# Runtime
MODE=local
ENABLE_LOCAL_TEST=false

# Watermark
WATERMARK_TEXT=MITFLOWW

# false = repeated text watermark
# true = repeated logo + text watermark
IS_LOGO_WATERMARK=true

# Relative to worker project root
WATERMARK_LOGO_PATH=assets/watermark.png

# Lower = more readable file. Higher = more protection.
IMAGE_WATERMARK_OPACITY=0.14
VIDEO_WATERMARK_OPACITY=0.12
PDF_WATERMARK_OPACITY=0.12

WATERMARK_ANGLE=-32

# Optional logo sizing
WATERMARK_LOGO_WIDTH_RATIO=0.16
WATERMARK_LOGO_HEIGHT_RATIO=0.36

# Diagonal angle for generated image/video pattern.
WATERMARK_ANGLE=-32

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FFmpeg / FFprobe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Large file limits
# Keep aligned with actual worker disk capacity.
# On a 40GB worker, very large values can still fail admission (input + output + safety).
# 20GB. Raise later if product limit increases.
MAX_UPLOAD_BYTES=21474836480
MAX_OUTPUT_BYTES=21474836480

# Video processing safety
# 0 = no absolute max runtime. Correct for very large videos.
FFMPEG_MAX_RUNTIME_MS=0

# 30 min without FFmpeg progress before treating as stalled.
# Use 0 if you want to disable stall detection completely.
FFMPEG_STALL_LIMIT_MS=1800000

# Orphan recovery only. Active BullMQ jobs are skipped by code.
STUCK_JOB_THRESHOLD_MS=7200000

# Local desktop-safe concurrency
FAST_CONCURRENCY=2
MEDIUM_CONCURRENCY=2
HEAVY_CONCURRENCY=1
IMAGE_CONCURRENCY=2

# Global CPU limiter
IMAGE_CPU_LIMIT=2
SMALL_CPU_LIMIT=2
MEDIUM_CPU_LIMIT=2
HEAVY_CPU_LIMIT=1

# Per-user limits
USER_LIMIT_FREE=2
USER_LIMIT_BASIC=2
USER_LIMIT_PRO=4
USER_LIMIT_STUDIO=6
USER_LIMIT_BUSINESS=8

# R2 upload concurrency
MAX_PARALLEL_UPLOADS=2

# Processing retries
MAX_PROCESSING_ATTEMPTS=3
MAX_MANUAL_RETRIES=3

# Resource wait retry policy
RESOURCE_RETRY_DELAY_MS=60000
MAX_RESOURCE_WAIT_MS=86400000
MAX_RESOURCE_WAIT_COUNT=1440

# Disable non-R2 inputs
ALLOW_LOCAL_FILE_INPUTS=false
ALLOW_REMOTE_INPUT_URLS=false

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION=1000

# Disk safety
# For a 40GB worker:
# - keep at least ~8GB free during work
# - cleanup target around ~12GB
# - do not set TARGET_FREE_DISK above actual disk capacity
MIN_FREE_DISK=8589934592
TARGET_FREE_DISK=12884901888
DISK_RESERVATION_MULTIPLIER=2.5
DISK_RESERVATION_MIN_BYTES=524288000

# Temp cleanup safety
TEMP_CLEANUP_MIN_AGE_MS=3600000
FAILED_TEMP_RETENTION_MS=1800000

# Admin WS snapshot interval
WS_SNAPSHOT_INTERVAL_MS=5000

# Image safety
MAX_IMAGE_PIXELS=50000000

# PDF safety
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION=14400
PDF_PROCESSING_TIMEOUT_MS=60000

# Internal auth
WORKER_API_TOKEN=dev-worker-token
PROCESSING_CALLBACK_TOKEN=dev-callback-token

# ETA fallback for large video workloads
VIDEO_LARGE_ESTIMATE_MS_PER_GB=600000

# Optional admin/ws auth for local. Keep empty for now.
ADMIN_TOKEN=
WS_TOKEN=

# R2
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=mitfloww-files-dev

# Not needed in local mode unless you use /preview or public R2 URLs from worker.
# R2_PUBLIC_BASE_URL=https://your-public-r2-domain