# Mode
MODE=local

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FFmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_MAX_THREADS=2
MAX_PARALLEL_UPLOADS=3

# Paths (optional)
# TEMP_DIR=
OUTPUT_DIR=./outputs

# Concurrency
FAST_CONCURRENCY=5
MEDIUM_CONCURRENCY=3
HEAVY_CONCURRENCY=1
IMAGE_CONCURRENCY=15

# Max operations per RATE_LIMIT_DURATION
RATE_LIMIT_MAX=10
# Duration in milliseconds for rate limiting
RATE_LIMIT_DURATION=1000

# Disk safety
MIN_FREE_DISK=5368709120
TARGET_FREE_DISK=10737418240

# Server
PORT=4000
WS_PORT=4001