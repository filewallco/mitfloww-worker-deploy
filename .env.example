# Runtime
MODE=local
ENABLE_LOCAL_TEST=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FFmpeg / FFprobe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Large file limits
# 20GB. Raise later if product limit increases.
MAX_UPLOAD_BYTES=21474836480
MAX_OUTPUT_BYTES=21474836480

# Video processing safety
# 0 = no absolute max runtime. Correct for very large videos.
FFMPEG_MAX_RUNTIME_MS=0

# 30 min without FFmpeg progress before treating as stalled.
# Use 0 if you want to disable stall detection completely.
FFMPEG_STALL_LIMIT_MS=1800000

# Orphan recovery only. Active BullMQ jobs are skipped by code.
STUCK_JOB_THRESHOLD_MS=7200000

# Local desktop-safe concurrency
FAST_CONCURRENCY=1
MEDIUM_CONCURRENCY=1
HEAVY_CONCURRENCY=1
IMAGE_CONCURRENCY=2

# Global CPU limiter
GLOBAL_CPU_LIMIT=1

# Per-user limits
USER_LIMIT_FREE=1
USER_LIMIT_PREMIUM=1
USER_LIMIT_VIP=1

# R2 upload concurrency
MAX_PARALLEL_UPLOADS=2

# Disable non-R2 inputs
ALLOW_LOCAL_FILE_INPUTS=false
ALLOW_REMOTE_INPUT_URLS=false

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION=1000

# Disk safety
# For 20GB upload support, local disk needs real headroom.
# 50GB minimum free, 80GB cleanup target.
MIN_FREE_DISK=53687091200
TARGET_FREE_DISK=85899345920

# Image safety
MAX_IMAGE_PIXELS=50000000

# PDF safety
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION=14400
PDF_PROCESSING_TIMEOUT_MS=60000

# Internal auth
WORKER_API_TOKEN=dev-worker-token
PROCESSING_CALLBACK_TOKEN=dev-callback-token

# Optional admin/ws auth for local. Keep empty for now.
ADMIN_TOKEN=
WS_TOKEN=

# R2
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=mitfloww-files-dev

# Not needed in local mode unless you use /preview or public R2 URLs from worker.
# R2_PUBLIC_BASE_URL=https://your-public-r2-domain