# ==============================================================================
# MitFloww Worker Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the worker.
# NEVER commit .env with real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Mode
# ------------------------------------------------------------------------------
NODE_ENV=production
MODE=server
ENABLE_LOCAL_TEST=false

# ------------------------------------------------------------------------------
# 2. Server Ports & Internal Networking
# ------------------------------------------------------------------------------
PORT=4000
WS_PORT=4002
WS_SNAPSHOT_INTERVAL_MS=5000

# ------------------------------------------------------------------------------
# 3. Security Tokens & Internal Authentication
# ------------------------------------------------------------------------------
# Pre-shared bearer token for internal communication between Next.js API & Worker
WORKER_API_TOKEN=change-me-to-a-secure-random-token
# Token used by worker when calling back into Next.js API after job completion
PROCESSING_CALLBACK_TOKEN=change-me-to-a-secure-random-token
# Optional admin dashboard / WS access tokens
ADMIN_TOKEN=
WS_TOKEN=

# ------------------------------------------------------------------------------
# 4. Redis Connection (BullMQ & State Management)
# ------------------------------------------------------------------------------
# Standard Redis connection URL (recommended):
REDIS_URL=redis://127.0.0.1:6379
# Fallback individual parameters (used if REDIS_URL is not set):
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Database Connection (Optional Persistent Logging)
# ------------------------------------------------------------------------------
# PostgreSQL database URL used for optional persistent worker operational logs
DATABASE_URL=

# ------------------------------------------------------------------------------
# 6. Storage Provider & Cloudflare R2
# ------------------------------------------------------------------------------
# Storage mode: 'r2' for production object storage, 'server' or 'local' for local disk
STORAGE_PROVIDER=r2
LOCAL_STORAGE_PATH=/storage

# Cloudflare R2 Credentials
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=mitfloww-files-prod
# Base URL for public previews (e.g. CDN or public bucket endpoint)
R2_PUBLIC_BASE_URL=https://media.yourdomain.com

# Input security rules
ALLOW_LOCAL_FILE_INPUTS=false
ALLOW_REMOTE_INPUT_URLS=false

# ------------------------------------------------------------------------------
# 7. Worker Concurrency & Multi-core Settings (Optimized for 4-vCPU ARM A1)
# ------------------------------------------------------------------------------
# Global worker concurrency override (optional fallback for all queues)
WORKER_CONCURRENCY=1

# Per-queue BullMQ concurrency
FAST_CONCURRENCY=2
MEDIUM_CONCURRENCY=2
HEAVY_CONCURRENCY=1
IMAGE_CONCURRENCY=2

# Global CPU lane semaphores
IMAGE_CPU_LIMIT=2
SMALL_CPU_LIMIT=2
MEDIUM_CPU_LIMIT=2
HEAVY_CPU_LIMIT=1
GLOBAL_CPU_LIMIT=4

# FFmpeg encoding threads per process (keep conservative on 4 vCPUs)
FFMPEG_MAX_THREADS=2
# Concurrent R2 multipart upload parts
MAX_PARALLEL_UPLOADS=2

# ------------------------------------------------------------------------------
# 8. Watermark Configuration
# ------------------------------------------------------------------------------
WATERMARK_TEXT=MITFLOWW
IS_LOGO_WATERMARK=true
# Relative to application root (/app in Docker container)
WATERMARK_LOGO_PATH=assets/watermark.png
WATERMARK_AUDIO_PATH=assets/watermark-audio.mp3

# Watermark styling & opacity
IMAGE_WATERMARK_OPACITY=0.14
VIDEO_WATERMARK_OPACITY=0.12
PDF_WATERMARK_OPACITY=0.12
WATERMARK_ANGLE=-32
WATERMARK_LOGO_WIDTH_RATIO=0.16
WATERMARK_LOGO_HEIGHT_RATIO=0.36
WATERMARK_LOGO_OPACITY=0.45

# ------------------------------------------------------------------------------
# 9. Processing Limits & Safety Constraints
# ------------------------------------------------------------------------------
# Maximum file sizes (e.g., 20 GB)
MAX_UPLOAD_BYTES=21474836480
MAX_OUTPUT_BYTES=21474836480

# Image safety
MAX_IMAGE_PIXELS=50000000

# PDF safety
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION=14400
PDF_PROCESSING_TIMEOUT_MS=60000

# Video stall & runtime limits (0 = unlimited absolute runtime)
FFMPEG_MAX_RUNTIME_MS=0
FFMPEG_STALL_LIMIT_MS=1800000
STUCK_JOB_THRESHOLD_MS=180000
VIDEO_LARGE_ESTIMATE_MS_PER_GB=600000

# ------------------------------------------------------------------------------
# 10. Disk Reservation & Cleanup Policy
# ------------------------------------------------------------------------------
# Minimum and target free disk thresholds (in bytes, for a ~40GB worker volume)
MIN_FREE_DISK=8589934592
TARGET_FREE_DISK=12884901888
DISK_RESERVATION_MULTIPLIER=2.5
DISK_RESERVATION_MIN_BYTES=524288000

# Retention policies
TEMP_CLEANUP_MIN_AGE_MS=3600000
FAILED_TEMP_RETENTION_MS=1800000
MAINTENANCE_RETENTION_MS=259200000

# ------------------------------------------------------------------------------
# 11. Retries & Per-User Fairness
# ------------------------------------------------------------------------------
MAX_PROCESSING_ATTEMPTS=3
MAX_MANUAL_RETRIES=3
RESOURCE_RETRY_DELAY_MS=60000
MAX_RESOURCE_WAIT_MS=86400000
MAX_RESOURCE_WAIT_COUNT=1440

RATE_LIMIT_MAX=10
RATE_LIMIT_DURATION=1000

# Per-user active job limits
USER_LIMIT_FREE=2
USER_LIMIT_STANDARD=2
USER_LIMIT_PRO=4
USER_LIMIT_STUDIO=6
USER_LIMIT_BUSINESS=8

# ------------------------------------------------------------------------------
# 12. Binary & Storage Paths (Standard container defaults)
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TEMP_DIR=/app/tmp
OUTPUT_DIR=/app/outputs