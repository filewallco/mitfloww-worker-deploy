# Mode
MODE=local
ENABLE_LOCAL_TEST=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FFmpeg
FFMPEG_PATH=ffmpeg
FFMPEG_MAX_THREADS=2
MAX_PARALLEL_UPLOADS=3

# Paths (optional)
# TEMP_DIR=
OUTPUT_DIR=./outputs

# Concurrency
FAST_CONCURRENCY=5
MEDIUM_CONCURRENCY=3
HEAVY_CONCURRENCY=1
IMAGE_CONCURRENCY=15

# Max operations per RATE_LIMIT_DURATION
RATE_LIMIT_MAX=10
# Duration in milliseconds for rate limiting
RATE_LIMIT_DURATION=1000

# Disk safety
MIN_FREE_DISK=5368709120
TARGET_FREE_DISK=10737418240
MAX_UPLOAD_BYTES=5368709120
MAX_OUTPUT_BYTES=5368709120
MAX_IMAGE_PIXELS=50000000
MAX_PDF_BYTES=104857600
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION=14400
PDF_PROCESSING_TIMEOUT_MS=60000

# Server
PORT=4000
WS_PORT=4001
ADMIN_TOKEN=
WS_TOKEN=

WORKER_API_TOKEN=dev-worker-token
PROCESSING_CALLBACK_TOKEN=dev-callback-token

R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=mitfloww-files-dev
R2_PUBLIC_BASE_URL=https://your-public-r2-domain