# Running mode: local or server
MODE=local

# Redis server host
REDIS_HOST=127.0.0.1
# Redis server port
REDIS_PORT=6379

# Path to ffmpeg binary
FFMPEG_PATH=ffmpeg
# Optional: temp dir eg:- ./temp; fallback used if empty  
TEMP_DIR=
# Directory for processed outputs        
OUTPUT_DIR=./outputs

# Max concurrent jobs
MAX_CONCURRENCY=5
# Max operations per RATE_LIMIT_DURATION
RATE_LIMIT_MAX=10
# Duration in milliseconds for rate limiting
RATE_LIMIT_DURATION=1000